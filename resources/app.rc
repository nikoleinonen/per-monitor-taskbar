#include <windows.h>
#include "pmt_version.h"
#include "resource.h"

// Embed application manifest
1 24 "app.manifest"

IDI_APP ICON "app.ico"
IDI_TRAY_DARK ICON "tray_dark.ico"
IDI_TRAY_LIGHT ICON "tray_light.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION PMT_VERSION_MAJOR,PMT_VERSION_MINOR,PMT_VERSION_PATCH,0
PRODUCTVERSION PMT_VERSION_MAJOR,PMT_VERSION_MINOR,PMT_VERSION_PATCH,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "per-monitor-taskbar"
      VALUE "FileDescription", "Per-monitor taskbar auto-hide"
      VALUE "FileVersion", PMT_VERSION_STR
      VALUE "InternalName", "per-monitor-taskbar"
      VALUE "OriginalFilename", PMT_ORIGINAL_FILENAME
      VALUE "ProductName", "Per-Monitor Taskbar"
      VALUE "ProductVersion", PMT_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
